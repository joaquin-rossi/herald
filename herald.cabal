cabal-version:      3.0
name:               herald
version:            0.1.0.0
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Joaquín Rossi
maintainer:         joaquin@joaquinrossi.net
category:           Sound
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import: warnings

    exposed-modules:
        Herald.Instrument,
        Herald.Music,
        Herald.Music.Pitch,
        Herald.Sound,
        Herald.Sound.IO

    hs-source-dirs:   src
    default-language: GHC2024
    build-depends:
        base ^>=4.20.2.0,
        bytestring ^>=0.12.2.0,
        mtl ^>=2.3.2,
        process ^>=1.6.26.1,

executable demo
    import: warnings

    main-is: Main.hs
    other-modules:
        Demo.Music.HappyBirthday
        Demo.Music.LittleFugueInGMinor

    hs-source-dirs:   demo
    default-language: GHC2024
    build-depends:
        base ^>=4.20.2.0,
        herald,
